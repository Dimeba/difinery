# Copy the values you need into .env.local (git-ignored) and into
# Netlify → Site settings → Environment variables.

# ── Shopify Storefront (existing) ─────────────────────────────────────────────
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# ── Contentful (existing) ─────────────────────────────────────────────────────
NEXT_PUBLIC_CONTENTFUL_SPACE_ID=
NEXT_PUBLIC_CONTENTFUL_ACCESS_KEY=

# ── Site ──────────────────────────────────────────────────────────────────────
# Must match the origin the Customer Account API callback URI is registered on.
NEXT_PUBLIC_SITE_URL=https://difinery.com

# ── Shopify Customer Accounts ─────────────────────────────────────────────────
# From: Shopify admin → Sales channels → Headless → <storefront>
#       → Customer Account API settings
#
# WARNING: these are server-only. Never add them to the `env:` block in
# next.config.mjs and never prefix them with NEXT_PUBLIC_ — either would inline
# the client secret into the browser bundle.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=

# "Application endpoints" section on the same admin page.
SHOPIFY_CA_AUTHORIZE_URL=
SHOPIFY_CA_TOKEN_URL=
SHOPIFY_CA_LOGOUT_URL=
# e.g. https://shopify.com/<shop_id>/account/customer/api/2026-07/graphql
SHOPIFY_CA_GRAPHQL_URL=

# ── Klaviyo (existing, server-only) ───────────────────────────────────────────
KLAVIYO_API_KEY=
KLAVIYO_LIST_SUBSCRIBERS_ID=
KLAVIYO_LIST_BLANK_CANVAS_ID=
KLAVIYO_LIST_SPECIAL_REQUESTS_ID=

# ── UBS staff program (server-only) ───────────────────────────────────────────
# Discount code applied to the cart of signed-in customers whose verified email
# is on one of the domains below. Never prefix with NEXT_PUBLIC_.
# In Shopify admin, restrict the code to a customer segment with the same
# email domains so it cannot be used by anyone else at checkout.
UBS_DISCOUNT_CODE=
# Comma separated. Remove test domains (desophy.com) in production.
UBS_ELIGIBLE_DOMAINS=ubs.com
